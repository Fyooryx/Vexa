<html lang='en' theme-type='{{APP_THEME_TYPE}}'>

  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0, interactive-widget=resizes-content' />
    <meta http-equiv='X-UA-Compatible' content='ie=edge' />
    <link rel='stylesheet' href='{{CONSOLE_THEME_STYLE}}' />
    <meta name='vexa-console-theme-endpoint' content='{{CONSOLE_THEME_STATE}}' />
    {{#EXECUTING_SCRIPT}}
    <meta name='vexa-console-executing-script' content='{{EXECUTING_SCRIPT}}' />
    {{/EXECUTING_SCRIPT}}
    <link rel="icon" href="icons/vexa.svg" type="image/svg+xml">
    <title>Console</title>
    <script>
      sessionStorage.setItem('__mode', 'console');
      window.__consoleWorkerScript = '{{CONSOLE_WORKER_SCRIPT}}';
    </script>
    <script src='{{CONSOLE_SCRIPT}}' crossorigin='anonymous'></script>
  </head>

  <body></body>

</html>
